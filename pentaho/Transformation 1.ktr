    <connection>Origen_Medcentro</connection>
    <sql>SELECT 'HIS.Paciente' AS tabla_origen, COUNT(*) AS total_registros,
       SUM(CASE WHEN RUN IS NULL THEN 1 ELSE 0 END) AS nulos_run,
       SUM(CASE WHEN Nombres IS NULL THEN 1 ELSE 0 END) AS nulos_nombres
FROM HIS.Paciente
UNION ALL
SELECT 'HIS.Profesional', COUNT(*),
       SUM(CASE WHEN RUN IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN NombreCompleto IS NULL THEN 1 ELSE 0 END)
FROM HIS.Profesional
UNION ALL
SELECT 'HIS.EpisodioClinico', COUNT(*),
       SUM(CASE WHEN PacienteHISID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN FechaHoraIngreso IS NULL THEN 1 ELSE 0 END)
FROM HIS.EpisodioClinico
UNION ALL
SELECT 'HIS.DiagnosticoEpisodio', COUNT(*),
       SUM(CASE WHEN EpisodioHISID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN CodigoCIE10 IS NULL THEN 1 ELSE 0 END)
FROM HIS.DiagnosticoEpisodio
UNION ALL
SELECT 'LIS.OrdenLaboratorio', COUNT(*),
       SUM(CASE WHEN PacienteHISID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN CodigoOrden IS NULL THEN 1 ELSE 0 END)
FROM LIS.OrdenLaboratorio
UNION ALL
SELECT 'LIS.ResultadoLaboratorio', COUNT(*),
       SUM(CASE WHEN OrdenLISID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN CodigoLOINC IS NULL THEN 1 ELSE 0 END)
FROM LIS.ResultadoLaboratorio
UNION ALL
SELECT 'PACS.EstudioDICOM', COUNT(*),
       SUM(CASE WHEN PacienteHISID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN StudyInstanceUID IS NULL THEN 1 ELSE 0 END)
FROM PACS.EstudioDICOM
UNION ALL
SELECT 'IOT.SesionMonitorizacionUCI', COUNT(*),
       SUM(CASE WHEN PacienteHISID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN DispositivoID IS NULL THEN 1 ELSE 0 END)
FROM IOT.SesionMonitorizacionUCI
UNION ALL
SELECT 'IOT.EventoSignosVitalesMQTT', COUNT(*),
       SUM(CASE WHEN SesionIOTID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN PayloadJson IS NULL THEN 1 ELSE 0 END)
FROM IOT.EventoSignosVitalesMQTT
UNION ALL
SELECT 'SAP.DocumentoFinanciero', COUNT(*),
       SUM(CASE WHEN PacienteHISID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN MontoNeto IS NULL THEN 1 ELSE 0 END)
FROM SAP.DocumentoFinanciero
UNION ALL
SELECT 'SAP.DetalleDocumento', COUNT(*),
       SUM(CASE WHEN DocumentoSAPID IS NULL THEN 1 ELSE 0 END),
       SUM(CASE WHEN TotalLinea IS NULL THEN 1 ELSE 0 END)
FROM SAP.DetalleDocumento;</sql>
